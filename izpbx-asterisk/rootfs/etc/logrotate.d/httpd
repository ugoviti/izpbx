# Apache logs (Debian: /var/log/apache2); replaces Debian's
# /etc/logrotate.d/apache2, which reloads through invoke-rc.d
/var/log/apache2/*log {
  daily
  ifempty
  rotate 7
  missingok
  compress
  dateext
  copytruncate
  sharedscripts
  postrotate
    if izpbx-service status httpd > /dev/null 2>&1; then \
      izpbx-service restart httpd > /dev/null 2>&1; \
    fi;
  endscript
}
