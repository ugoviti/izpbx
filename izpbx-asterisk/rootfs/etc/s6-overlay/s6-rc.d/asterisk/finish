#!/bin/bash
# s6 finish of asterisk: $1 = exit code (256 if killed by a signal), $2 = signal.
# exit 0: Asterisk stopped on request (core stop, fwconsole stop) or the
# service is disabled: stay down until "fwconsole start" (safe_asterisk shim).
# Any other exit but SIGTERM is a failure; MAX failures in a row stop the
# container with exit code 1 (T17).
MAX=3
count_file=/run/izpbx-asterisk-failures
if [ "$1" -eq 0 ]; then
  rm -f "$count_file"
  exec /command/s6-svc -d .
fi
[ "${2:-}" = "15" ] && { rm -f "$count_file"; exit 0; }
n=$(( $(cat "$count_file" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$count_file"
echo "izpbx: error: asterisk failed ($n/$MAX, exit=$1 signal=${2:-})" >&2
if [ "$n" -ge "$MAX" ]; then
  echo "izpbx: error: asterisk failed $MAX times in a row, stopping the container" >&2
  echo 1 > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi
