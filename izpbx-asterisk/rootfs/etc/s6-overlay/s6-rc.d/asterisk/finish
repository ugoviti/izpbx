#!/command/with-contenv bash
# shellcheck shell=bash
# s6 finish of asterisk: $1 = exit code (256 if killed by a signal), $2 = signal.
# exit 0: Asterisk stopped on request (core stop, fwconsole stop) or the
# service is disabled: stay down until "fwconsole start" (safe_asterisk shim).
# Any other exit but SIGTERM is a failure; MAX failures in a row stop the
# container with exit code 1 (design S5, T17), as the 20.16 watchdog did when
# supervisord gave up. "In a row": a failure after Asterisk has been up for
# WINDOW seconds or more starts the count again, so isolated crashes weeks
# apart do not stop the PBX.
# shellcheck source=../../../../usr/local/lib/izpbx/common.sh
. /usr/local/lib/izpbx/common.sh
MAX=3
WINDOW=60
count_file=/run/izpbx-asterisk-failures
if [ "$1" -eq 0 ]; then
  rm -f "$count_file"
  exec /command/s6-svc -d .
fi
[ "${2:-}" = "15" ] && { rm -f "$count_file"; exit 0; }
started=$(cat /run/izpbx-asterisk-started 2>/dev/null || echo 0)
[ $(( $(date +%s) - started )) -ge "$WINDOW" ] && rm -f "$count_file"
n=$(( $(cat "$count_file" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$count_file"
log_error "asterisk: failed ($n/$MAX, exit=$1 signal=${2:-})"
if [ "$n" -ge "$MAX" ]; then
  log_error "asterisk: failed $MAX times in a row, stopping the container"
  echo 1 > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi
