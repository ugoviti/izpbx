#!/command/with-contenv bash
# shellcheck shell=bash
# chronyd without control of the system clock (-x): a container has no
# CAP_SYS_TIME; it serves time to the LAN and reports the offset
. /usr/local/lib/izpbx/service.sh
service_enabled NTP_ENABLED false || service_off ntp
mkdir -p /run/chrony
exec chronyd -d -x
