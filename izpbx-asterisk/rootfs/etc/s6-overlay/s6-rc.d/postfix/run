#!/command/with-contenv bash
# shellcheck shell=bash
. /usr/local/lib/izpbx/service.sh
service_gate postfix
# "postfix start-fg" execs the master only as PID 1; otherwise it starts it
# as a child, and a stop (SIGTERM to the script) leaves master, qmgr and
# pickup behind: run the master in the foreground directly (-s, the mode
# start-fg uses), so s6 supervises the master itself. The integrity check
# ("postfix check") runs in izpbx-init (services/postfix.sh): here it would
# be left behind by a stop that arrives while it runs.
exec /usr/lib/postfix/sbin/master -s
