#!/bin/bash
# izpbx-blfmonitor: BLF of the lines of a trunk. Every REFRESH seconds counts
# the channels of TRUNK and sets the custom device states Custom:linea1 ..
# Custom:lineaN: BUSY for the lines in use, NOT_INUSE for the free ones (a
# phone key on Custom:lineaX shows if line X is in use).
#   izpbx-blfmonitor [-t TRUNK] [-l LINES] [-T TECH] [-r REFRESH] [-1] [-D] [start|stop|restart|status]
#   -t   trunk name (default terra)        -l   lines of the trunk (default 4)
#   -T   channel technology (default PJSIP; chan_sip is gone in Asterisk 22)
#   -r   refresh seconds (default 5)        -1   one pass and exit
#   -D   print the counts                   no command: run in the foreground
# Written by Luca Mafucci <luca.mafucci@initzero.it> (2014), ported to izPBX 22.17.
set -euo pipefail
usage() { sed -n '6,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
trunk=terra lines=4 tech=PJSIP refresh=5 once=0 debug=0
pidfile=/run/izpbx-blfmonitor.pid log=/var/log/izpbx-blfmonitor.log
while getopts "t:l:T:r:1Dh" o; do
  case $o in
    t) trunk=$OPTARG ;; l) lines=$OPTARG ;; T) tech=$OPTARG ;; r) refresh=$OPTARG ;;
    1) once=1 ;; D) debug=1 ;; *) usage ;;
  esac
done
shift $((OPTIND - 1))
cmd=${1:-}
[[ "$lines" =~ ^[0-9]+$ ]] && [[ "$refresh" =~ ^[0-9]+$ ]] && [ "$refresh" -gt 0 ] || usage

blf_pass() {
  local active i
  active=$(asterisk -rx "core show channels" 2>/dev/null | grep -c "^$tech/$trunk-" || true)
  [ "$active" -le "$lines" ] || active=$lines
  [ "$debug" -eq 0 ] || echo "$(date +%T) $tech/$trunk: $active of $lines line(s) in use"
  for ((i = 1; i <= lines; i++)); do
    if [ "$i" -le "$active" ]; then asterisk -rx "devstate change Custom:linea$i BUSY" >/dev/null
    else asterisk -rx "devstate change Custom:linea$i NOT_INUSE" >/dev/null; fi
  done
}
blf_loop() { while true; do blf_pass; [ "$once" -eq 0 ] || return 0; sleep "$refresh"; done; }
running() { [ -s "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }

case $cmd in
  "")      blf_loop ;;
  start)   if running; then echo "already running (pid $(cat "$pidfile"))"; exit 0; fi
           nohup "$0" -t "$trunk" -l "$lines" -T "$tech" -r "$refresh" >> "$log" 2>&1 &
           echo $! > "$pidfile"; echo "started (pid $!, log $log)" ;;
  stop)    if running; then kill "$(cat "$pidfile")"; echo "stopped (pid $(cat "$pidfile"))"; else echo "not running"; fi
           rm -f "$pidfile" ;;
  restart) "$0" -t "$trunk" -l "$lines" -T "$tech" -r "$refresh" stop; "$0" -t "$trunk" -l "$lines" -T "$tech" -r "$refresh" start ;;
  status)  if running; then echo "running (pid $(cat "$pidfile"))"; else echo "not running"; exit 3; fi ;;
  *)       usage ;;
esac
