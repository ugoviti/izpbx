#!/bin/bash
# izpbx-callstats: the calls in progress, one per line (from "core show
# channels concise"): number, originating channel, caller ID, called number,
# state and duration.
#   izpbx-callstats [-b] [-d]
#   -b   brief: one sentence per call, no table
#   -d   debug: also the application and the full channel name
# Written by Ugo Viti <u.viti@wearequantico.it> (2017), ported to izPBX 22.17.
set -euo pipefail
usage() { sed -n '5,7p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
brief=0 debug=0
while getopts "bdh" o; do case $o in b) brief=1 ;; d) debug=1 ;; *) usage ;; esac; done

duration() { # seconds -> [N day ]HH:MM:SS
  local s=$1 d
  d=$((s / 86400)); s=$((s % 86400))
  if [ "$d" -gt 0 ]; then printf '%d day %02d:%02d:%02d' "$d" $((s / 3600)) $((s % 3600 / 60)) $((s % 60))
  else printf '%02d:%02d:%02d' $((s / 3600)) $((s % 3600 / 60)) $((s % 60)); fi
}

channels=$(mktemp)
trap 'rm -f "$channels"' EXIT
asterisk -rx "core show channels concise" > "$channels" 2>/dev/null || true

calls() {
  local n=1 channel state app data cid secs bridge did orig
  while IFS='!' read -r channel _ _ _ state app data cid _ _ _ secs bridge _; do
    [ -n "$channel" ] && [ "$app" != "AppDial" ] && [[ "$secs" =~ ^[0-9]+$ ]] || continue
    [[ "$data" != *"(Outgoing Line)"* ]] || continue
    orig=${channel#*/}; orig=${orig%%@*}; orig=${orig%-*}
    if [ -z "$bridge" ]; then
      # the dialed peers: first argument of Dial, technology removed
      did=${data%%,*}; did=$(sed -E 's#(PJSIP|SIP|IAX2|DAHDI|Local)/##g; s/&/,/g' <<< "$did")
    else
      did=$(awk -F'!' -v b="$bridge" '$13 == b && $6 == "AppDial" {print $8; exit}' "$channels")
    fi
    [ -n "$did" ] || did=${data%%,*}
    [ -n "$did" ] || did=$app
    # an empty field would shift the columns of the table
    cid=${cid:--} did=${did:--} orig=${orig:--} state=${state:--}
    if [ "$brief" -eq 1 ]; then
      if [ "$debug" -eq 1 ]; then
        echo "$n) from:[$cid] to:[$did] state:[$state] app:[$app] channel:[$channel] duration:[$(duration "$secs")]"
      else
        echo "$n) orig:[$orig] from:[$cid] to:[$did] duration:[$(duration "$secs")]"
      fi
    elif [ "$debug" -eq 1 ]; then
      echo "$n $cid $did $state $app $channel $(duration "$secs" | tr ' ' '_')"
    else
      echo "$n $orig $cid $did $state $(duration "$secs" | tr ' ' '_')"
    fi
    n=$((n + 1))
  done < "$channels"
}

if [ "$brief" -eq 1 ]; then
  calls
elif [ "$debug" -eq 1 ]; then
  { echo "N. FROM TO STATE APPLICATION CHANNEL DURATION"; calls; } | column -t
else
  { echo "N. ORIG FROM TO STATE DURATION"; calls; } | column -t
fi
