#!/bin/bash
# izpbx-trunkrotate: rotate the order of the trunks of an outbound route at
# every run (eg. the SIMs of a GSM gateway used in turn, day after day): the
# first trunk goes last, the others move up. Then FreePBX applies it
# (fwconsole reload).
#   izpbx-trunkrotate [-n] ROUTE TRUNK TRUNK...
#   -n   print the new order, change nothing
# The FreePBX database as the rest of izPBX (MYSQL_*). Exit 0, 1 when the route
# or a trunk is not found or the reload fails, 2 on a usage error.
# Written by Ugo Viti <ugo.viti@initzero.it> (2013), ported to izPBX 22.17.
set -euo pipefail
usage() { sed -n '6,7p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
# shellcheck source=../lib/izpbx/actions.sh
. /usr/local/lib/izpbx/actions.sh
dry=0
while getopts "nh" o; do case $o in n) dry=1 ;; *) usage ;; esac; done
shift $((OPTIND - 1))
[ $# -ge 3 ] || usage
route=$1; shift
sq() { printf "'%s'" "${1//\'/\'\'}"; }   # SQL string literal
route_id=$(izpbx_sql_query "SELECT route_id FROM outbound_routes WHERE name = $(sq "$route")")
[ -n "$route_id" ] || { echo "route '$route' not found" >&2; exit 1; }
ids=() seqs=()
for t in "$@"; do
  id=$(izpbx_sql_query "SELECT trunkid FROM trunks WHERE name = $(sq "$t")")
  [ -n "$id" ] || { echo "trunk '$t' not found" >&2; exit 1; }
  seq=$(izpbx_sql_query "SELECT seq FROM outbound_route_trunks WHERE route_id = $route_id AND trunk_id = $id")
  [ -n "$seq" ] || { echo "trunk '$t' is not in the route '$route'" >&2; exit 1; }
  ids+=("$id"); seqs+=("$seq")
done
# the positions of these trunks, sorted: each trunk takes the position of the
# one before it in the order, the first one the last position
mapfile -t slots < <(printf '%s\n' "${seqs[@]}" | sort -n)
sql=''
for i in "${!ids[@]}"; do
  for j in "${!slots[@]}"; do [ "${slots[$j]}" == "${seqs[$i]}" ] && break; done
  new=${slots[$(( (j - 1 + ${#slots[@]}) % ${#slots[@]} ))]}
  echo "$(izpbx_sql_query "SELECT name FROM trunks WHERE trunkid = ${ids[$i]}"): position ${seqs[$i]} -> $new"
  sql+="UPDATE outbound_route_trunks SET seq = $new WHERE route_id = $route_id AND trunk_id = ${ids[$i]};"
done
[ "$dry" -eq 0 ] || exit 0
izpbx_sql "$sql"
su -s /bin/bash "${APP_USR:-asterisk}" -c "fwconsole reload" >/dev/null || { echo "fwconsole reload failed" >&2; exit 1; }
echo "route '$route' rotated and FreePBX reloaded"
