#!/bin/bash
# izpbx-init: container initialization, run once at start by the s6-rc
# oneshot "izpbx-init" (/etc/s6-overlay/s6-rc.d/izpbx-init) before any
# service: every service has izpbx-init in its dependencies.d, so if this
# script fails no service starts and the container stops
# (S6_BEHAVIOUR_IF_STAGE2_FAILS=2).
#
# Steps: /usr/local/lib/izpbx/init.d/*.sh, sourced in lexical order (NN-name.sh)
# in strict mode: the first failing command stops the init with file:line.
#
# --dry-run (or IZPBX_DRY_RUN=true): the files are generated, but database
# writes, "fwconsole setting" and other commands with outside effects are
# recorded in IZPBX_DRY_RUN_LOG instead of run (actions.sh), and the s6
# services stay down (service_gate). Used by the golden tests (design R3):
#   docker run --rm --entrypoint "" <image> izpbx-init --dry-run
# shellcheck source=../lib/izpbx/common.sh
. /usr/local/lib/izpbx/common.sh
izpbx_strict

: "${IZPBX_INIT_DIR:=/usr/local/lib/izpbx/init.d}"
case "${1:-}" in
  "") ;;
  --dry-run) export IZPBX_DRY_RUN=true ;;
  *) die "izpbx-init: unknown option '$1' (usage: izpbx-init [--dry-run])" ;;
esac
# the steps write the system configuration: a container started with
# "--user" (a one-off command as asterisk) gets no initialization, and its
# services cannot run either
if [ "$(id -u)" -ne 0 ]; then
  log_warn "izpbx-init: running as uid $(id -u), not root: initialization skipped"
  exit 0
fi
# shellcheck source=../lib/izpbx/env.sh
. /usr/local/lib/izpbx/env.sh
start=$SECONDS
# runtime state of izPBX: the dry-run log, the maintenance flag read by
# izpbx-healthcheck (a stale flag of a previous run does not survive /run),
# the start time for the "ready" line of freepbx-start
mkdir -p /run/izpbx
date +%s > /run/izpbx/started
# warnings and errors of the start, repeated in the final summary
export IZPBX_LOG_ISSUES=/run/izpbx/init-issues
: > "$IZPBX_LOG_ISSUES"
log_section "$APP_DESCRIPTION $APP_VER"
if [ "${IZPBX_DRY_RUN:-false}" == "true" ]; then
  : "${IZPBX_DRY_RUN_LOG:=/run/izpbx/dry-run.log}"
  mkdir -p "$(dirname "$IZPBX_DRY_RUN_LOG")" && : > "$IZPBX_DRY_RUN_LOG"
  log_info "izpbx-init: dry-run, actions recorded in $IZPBX_DRY_RUN_LOG"
else
  log_info "izpbx-init: build ${APP_VER_BUILD:-unknown}, commit ${APP_BUILD_COMMIT:-unknown}"
fi
# user hooks, as 20.16 (P3-38): ${APP_CUSTOM_SCRIPTS}/pre-init/*.custom-inc
# before the steps, ${APP_CUSTOM_SCRIPTS}/post-init/*.custom-inc after them
# (before any service starts), sourced in this shell in lexical order. They
# were written for the non strict shell of 20.16: strict mode is off while
# they run, and a hook that fails is logged, the start goes on. Not in
# dry-run; post-init not in maintenance mode.
run_custom_hooks() { # stage
  local dir="${APP_CUSTOM_SCRIPTS}/$1" inc rc
  if [ -z "$APP_CUSTOM_SCRIPTS" ]; then return 0; fi
  if [ "${IZPBX_DRY_RUN:-false}" == "true" ]; then log_info "izpbx-init: $1 hooks of $dir not run (dry-run)"; return 0; fi
  if [ ! -d "$dir" ]; then log_warn "izpbx-init: custom scripts directory $dir does not exist ($1 hooks)"; return 0; fi
  for inc in "$dir"/*.custom-inc; do
    [ -r "$inc" ] || continue
    izpbx_log_redirect "$1"
    log_info "izpbx-init: $1 hook $inc"
    set +Eeuo pipefail; trap - ERR
    # shellcheck source=/dev/null
    . "$inc"
    rc=$?
    izpbx_strict
    [ "$rc" -eq 0 ] || log_warn "izpbx-init: $1 hook $inc exited with status $rc"
  done
}
# the final summary: time (and the slow steps), services, web address, the
# warnings and errors. The services start after it: freepbx-start writes the
# "ready" line when Asterisk answers.
init_summary() {
  local issues=() line level warn=0 err=0 svc enabled=() url='' slow=''
  if [ -e "${IZPBX_MAINTENANCE_FLAG:-/run/izpbx/maintenance}" ]; then
    log_section "$APP_DESCRIPTION $APP_VER: MAINTENANCE MODE"
  else
    log_section "init summary"
  fi
  [ -s "$IZPBX_LOG_ISSUES" ] && mapfile -t issues < "$IZPBX_LOG_ISSUES"
  IZPBX_LOG_ISSUES=
  # the 3 slowest steps that took at least 1 second
  if [ ${#step_times[@]} -gt 0 ]; then
    slow=$(printf '%s\n' "${step_times[@]}" | sort -t$'\t' -k2,2nr | awk -F'\t' '$2 >= 1 && n++ < 3 {printf "%s%s %ss", (n > 1 ? ", " : ""), $1, $2}')
  fi
  log_ok "izpbx-init: done in $((SECONDS - start))s${slow:+ (slowest: $slow)}"
  if [ -e "${IZPBX_MAINTENANCE_FLAG:-/run/izpbx/maintenance}" ]; then
    log_error "izpbx-init: maintenance mode: no service starts ($(head -n 1 "${IZPBX_MAINTENANCE_FLAG:-/run/izpbx/maintenance}"))"
  else
    # shellcheck source=../lib/izpbx/service.sh
    . /usr/local/lib/izpbx/service.sh
    for svc in "${!SERVICE_VARS[@]}"; do service_is_enabled "$svc" && enabled+=("$svc"); done
    log_info "izpbx-init: services: $(printf '%s\n' "${enabled[@]}" | sort | paste -sd ' ')"
    if service_is_enabled httpd; then
      if [ "${HTTPD_HTTPS_ENABLED:-}" == "true" ]; then
        url="https://${SERVERNAME:-${APP_FQDN:-localhost}}$([ "${APP_PORT_HTTPS:-443}" == 443 ] || echo ":$APP_PORT_HTTPS")/"
      else
        url="http://${SERVERNAME:-${APP_FQDN:-localhost}}$([ "${APP_PORT_HTTP:-80}" == 80 ] || echo ":$APP_PORT_HTTP")/"
      fi
      log_info "izpbx-init: web: $url"
    fi
  fi
  for line in "${issues[@]}"; do
    case ${line%%$'\t'*} in warning) warn=$((warn + 1)) ;; error) err=$((err + 1)) ;; esac
  done
  if [ ${#issues[@]} -eq 0 ]; then
    log_ok "izpbx-init: no warnings or errors"
  else
    level=warning; [ "$err" -eq 0 ] || level=error
    izpbx_log "$level" "izpbx-init: $warn warning(s), $err error(s) during the start:"
    for line in "${issues[@]}"; do izpbx_log "${line%%$'\t'*}" "  ${line#*$'\t'}"; done
  fi
  log_section ""
}

shopt -s nullglob
run_custom_hooks pre-init
step_times=() # "18 freepbx<TAB>seconds"
for step in "$IZPBX_INIT_DIR"/*.sh; do
  # "18-freepbx.sh": section "18 freepbx" (written before its first line, a
  # step with nothing to say has none), output of its commands labeled "freepbx"
  name=$(basename "$step" .sh)
  izpbx_log_redirect "${name#[0-9]*-}" "" "${name/-/ }"
  step_start=$SECONDS
  # shellcheck source=/dev/null
  . "$step"
  step_times+=("${name/-/ }"$'\t'"$((SECONDS - step_start))")
  # maintenance mode (04-freepbx-detect.sh, 18-freepbx.sh): the next steps would write to
  # the FreePBX 16 /data, and no service runs anyway
  if [ -e "${IZPBX_MAINTENANCE_FLAG:-/run/izpbx/maintenance}" ]; then
    log_warn "izpbx-init: maintenance mode, the remaining steps are skipped"
    break
  fi
done
[ -e "${IZPBX_MAINTENANCE_FLAG:-/run/izpbx/maintenance}" ] || run_custom_hooks post-init
izpbx_log_redirect_end
init_summary
