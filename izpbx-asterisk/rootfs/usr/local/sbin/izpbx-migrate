#!/bin/bash
# izpbx-migrate: one phase of the FreePBX 16 -> 17 migration (design §7),
# as izpbx-init runs it; for tests and for a manual resume.
#   izpbx-migrate snapshot     M4: verified dumps, directories moved, spool hardlinked
#   izpbx-migrate archive      M5.1: FreePBX "legacy" backup archive from the raw data
#   izpbx-migrate restore      M5.2-M5.4: database recreated, FreePBX 17 installed, restore
#   izpbx-migrate sip-transport  M6: PJSIP transport on APP_PORT_SIP for the ex chan_sip trunks
#   izpbx-migrate audio        M6: custom prompts, sounds/custom and music on hold from the snapshot
#   izpbx-migrate astdb        M6: astdb keys the restore did not bring back (Asterisk stopped)
#   izpbx-migrate spool        M6: voicemail and recordings in place: counted, owned by asterisk
# State and snapshot in ${APP_DATA}/.izpbx-migration (services/migration.sh).
# shellcheck source=../lib/izpbx/common.sh
. /usr/local/lib/izpbx/common.sh
izpbx_strict
# shellcheck source=../lib/izpbx/services/migration.sh
. /usr/local/lib/izpbx/services/migration.sh

case "${1:-}" in
  snapshot) migration_snapshot ;;
  archive) migration_archive ;;
  restore) migration_restore ;;
  sip-transport) migration_sip_transport ;;
  audio) migration_audio ;;
  astdb) migration_astdb ;;
  spool) migration_spool ;;
  *) sed -n '4,10p' "$0" | sed 's/^# \{0,1\}/usage: /' >&2; exit 2 ;;
esac
