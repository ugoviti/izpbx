# shellcheck shell=bash
# izPBX interactive shell, as 20.16 (cfgBashEnv): banner, version line, prompt
# and aliases. /root/.bashrc only sources this file and is written again at
# every start (services/shell.sh, P3-29): put your own lines in /root/.bashrc.local.
case $- in *i*) ;; *) return ;; esac

. /etc/os-release
APP="izPBX"
# the domain part of the hostname, shown dimmed after it (none without a dot)
DOMAIN="$(hostname | cut -s -d'.' -f2)"
[ -z "$DOMAIN" ] || DOMAIN=".${DOMAIN}"

PS1="(${APP})\[\e[1;34m\][\[\e[1;33m\]\u@\[\e[1;32m\]\h\[\e[2m\]${DOMAIN}\[\e[0m\]: \[\e[1;37m\]\w\[\e[1;34m\]]\[\e[1;36m\]\\$ \[\e[0m\]"

# aliases
alias d="ls -lAsh --color"
alias cp="cp -ip"
alias rm="rm -i"
alias mv="mv -i"

_izpbx_ver() { sed -n "s/^$1=//p" /usr/src/izpbx/versions.env 2>/dev/null; }
_izpbx_build_date=${APP_BUILD_DATE:-}
[[ "$_izpbx_build_date" =~ ^[0-9]+$ ]] && _izpbx_build_date=$(date -d "@$_izpbx_build_date" +%Y-%m-%d)
printf '\e[1;34m'
figlet -w 120 "$APP" 2>/dev/null || echo "$APP"
printf '\e[1;36m%s \e[1;32m%s\e[1;36m (build: \e[1;32m%s\e[1;36m commit: \e[1;32m%s\e[1;36m date: \e[1;32m%s\e[1;36m), Asterisk \e[1;32m%s\e[1;36m, FreePBX \e[1;32m%s\e[1;36m, %s \e[1;32m%s\e[1;36m, Kernel \e[1;32m%s\e[0m\n\n' \
  "$APP" "${APP_VER:-unknown}" "${APP_VER_BUILD:-unknown}" "${APP_BUILD_COMMIT:-unknown}" "${_izpbx_build_date:-unknown}" \
  "$(_izpbx_ver ASTERISK_VER)" "$(_izpbx_ver FREEPBX_VER)" "${NAME:-unknown}" "${VERSION_ID:-unknown}" "$(uname -r)"
unset _izpbx_build_date
unset -f _izpbx_ver

[ ! -r /root/.bashrc.local ] || . /root/.bashrc.local
