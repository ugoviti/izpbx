# shellcheck shell=bash
# izPBX interactive shell (P3-29, P3-33): the banner when entering the
# container (logo, versions, live state of the PBX) and a two-line prompt with
# the health of the PBX and the calls in progress. /root/.bashrc only sources
# this file and is written again at every start (services/shell.sh): put your
# own lines in /root/.bashrc.local. Colors only on a terminal that has them,
# never with NO_COLOR set.
case $- in *i*) ;; *) return ;; esac

. /etc/os-release
_iz_maint=/run/izpbx/maintenance

# --- colors (empty without a color terminal)
if [ -z "${NO_COLOR:-}" ] && [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 256 ]; then
  _iz_c() { printf '\e[38;5;%sm' "$1"; }
  _iz_b=$'\e[1m' _iz_d=$'\e[2m' _iz_r=$'\e[0m'
  _iz_ok=$(_iz_c 42) _iz_ko=$(_iz_c 203) _iz_warn=$(_iz_c 214) _iz_dim=$(_iz_c 245) _iz_acc=$(_iz_c 45)
else
  _iz_c() { :; }
  _iz_b='' _iz_d='' _iz_r='' _iz_ok='' _iz_ko='' _iz_warn='' _iz_dim='' _iz_acc=''
fi

_iz_ver() { sed -n "s/^$1=//p" /usr/src/izpbx/versions.env 2>/dev/null; }
# up: answers on its console; starting: the daemon runs but does not answer yet
# (the first seconds of the container); down: no daemon. "asterisk -f" is the
# daemon: the "asterisk -rx" clients have the same process name.
_iz_asterisk_state() {
  if asterisk -rx 'core show uptime' 2>/dev/null | grep -q 'System uptime'; then echo up
  elif pgrep -f '^asterisk -f' >/dev/null 2>&1; then echo starting
  else echo down; fi
}
_iz_calls() { asterisk -rx 'core show channels count' 2>/dev/null | awk '/active call/ {print $1; exit}'; }

# --- the banner
_iz_motd() {
  local logo i colors fpbx health hcolor calls ep_on ep_all reg_ok reg_all build ast
  logo=(
    '▀  ▀▀█ █▀▀▄ █▀▀▄ ▀▄ ▄▀'
    '█  ▄▀  █▄▄▀ █▀▀▄  ▄▀▄ '
    '▀  ▀▀▀ ▀    ▀▀▀  ▀   ▀'
  )
  colors=(51 45 39)   # a cyan to blue gradient, one color per row
  echo
  for i in 0 1 2; do
    printf '   %s%s%s%s' "$_iz_b" "$(_iz_c "${colors[$i]}")" "${logo[$i]}" "$_iz_r"
    [ "$i" -ne 1 ] || printf '   %sCloud Native Telephony%s' "$_iz_dim" "$_iz_r"
    echo
  done
  echo
  fpbx=$(cat /data/.initialized 2>/dev/null || true); [[ "$fpbx" =~ ^[0-9.]+$ ]] || fpbx=$(_iz_ver FREEPBX_VER)
  build=''
  [ -z "${APP_VER_BUILD:-}" ] || build+=" · build $APP_VER_BUILD"
  [ -z "${APP_BUILD_COMMIT:-}" ] || build+=" · ${APP_BUILD_COMMIT}"
  printf '   %s%s%s%s%s · Asterisk %s · FreePBX %s · %s %s\n' "$_iz_b" "$_iz_acc" "${APP_VER:-unknown}" "$_iz_r" \
    "$_iz_dim$build$_iz_r" "$(_iz_ver ASTERISK_VER)" "${fpbx:-unknown}" "${NAME:-Linux}" "${VERSION_ID:-}"
  # live state
  if [ -e "$_iz_maint" ]; then
    printf '   %s● maintenance%s  %s\n' "$_iz_warn" "$_iz_r" "$(head -c 160 "$_iz_maint")"
  else
    ast=$(_iz_asterisk_state)
    health=$(timeout 3 izpbx-healthcheck 2>/dev/null) || true
    case $health in healthy) hcolor=$_iz_ok ;; "") health="state unknown" hcolor=$_iz_dim ;; *) hcolor=$_iz_ko ;; esac
    if [ "$ast" == starting ]; then
      printf '   %s● Asterisk is starting%s (not answering yet: log in again in a few seconds)' "$_iz_warn" "$_iz_r"
    else
      printf '   %s● %s%s' "$hcolor" "${health#unhealthy: }" "$_iz_r"
      [ "$health" == healthy ] || [ -z "$health" ] || [ "$hcolor" != "$_iz_ko" ] || printf ' %s(unhealthy)%s' "$_iz_ko" "$_iz_r"
    fi
    if [ "$ast" == up ]; then
      calls=$(_iz_calls)
      read -r ep_on ep_all < <(asterisk -rx 'pjsip show endpoints' 2>/dev/null |
        awk '/^ *Endpoint: / && !/</ {all++; if ($0 !~ /Unavailable/) on++} END {print on + 0, all + 0}')
      read -r reg_ok reg_all < <(asterisk -rx 'pjsip show registrations' 2>/dev/null |
        awk '/ (Registered|Unregistered|Rejected|Stopped|Failed)/ && !/</ {all++; if (/ Registered/) ok++} END {print ok + 0, all + 0}')
      printf '   %s calls   %s/%s endpoints   ' "${calls:-0}" "$ep_on" "$ep_all"
      if [ "$reg_all" -gt 0 ]; then printf '%s/%s trunks registered' "$reg_ok" "$reg_all"; else printf 'no trunk registration'; fi
    fi
    echo
  fi
  printf '   %stools: izpbx-<Tab> (-h for help) · logs: docker logs izpbx%s\n\n' "$_iz_dim" "$_iz_r"
}

# --- the prompt: ╭─ izpbx  user@host.domain  dir  ● N calls
#                 ╰─❯            (❯ red when the last command failed)
_iz_domain=$(hostname -f 2>/dev/null | cut -s -d. -f2-); [ -z "$_iz_domain" ] || _iz_domain=".$_iz_domain"
_iz_state_ts=0 _iz_state=''
_iz_refresh_state() { # at most every 10 seconds: the health dot and the calls
  local now calls ttl=10
  now=$(date +%s)
  # while Asterisk starts, again at every prompt: it answers within seconds
  [ "${_iz_state_kind:-}" != starting ] || ttl=0
  [ $((now - _iz_state_ts)) -ge "$ttl" ] || return 0
  _iz_state_ts=$now
  if [ -e "$_iz_maint" ]; then _iz_state_kind=maintenance _iz_state="\[$_iz_warn\]● maintenance\[$_iz_r\]"
  else
    _iz_state_kind=$(_iz_asterisk_state)
    case $_iz_state_kind in
      up)       calls=$(_iz_calls); _iz_state="\[$_iz_ok\]●\[$_iz_r\] ${calls:-0} calls" ;;
      starting) _iz_state="\[$_iz_warn\]● asterisk starting\[$_iz_r\]" ;;
      *)        _iz_state="\[$_iz_ko\]● asterisk down\[$_iz_r\]" ;;
    esac
  fi
}
_iz_prompt() {
  local rc=$? arrow=$_iz_acc
  [ "$rc" -eq 0 ] || arrow=$_iz_ko
  _iz_refresh_state
  PS1="\[$_iz_dim\]╭─\[$_iz_r\] \[$_iz_b$_iz_acc\]izpbx\[$_iz_r\]  \[$_iz_b\]\u@\h\[$_iz_r\]\[$_iz_dim\]${_iz_domain}\[$_iz_r\]  \[$_iz_acc\]\w\[$_iz_r\]  ${_iz_state}\n\[$_iz_dim\]╰─\[$_iz_r\]\[$arrow\]❯\[$_iz_r\] "
}
PROMPT_COMMAND="_iz_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# aliases, as 20.16
alias d="ls -lAsh --color"
alias cp="cp -ip"
alias rm="rm -i"
alias mv="mv -i"

_iz_motd

[ ! -r /root/.bashrc.local ] || . /root/.bashrc.local
