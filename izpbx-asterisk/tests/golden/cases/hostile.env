# values with characters that need escaping (R1, P3-21)
# expect: /etc/dnsmasq.d/local.conf /etc/aliases /etc/postfix/sasl_passwd /etc/postfix/main.cf
POSTFIX_ENABLED=true
SMTP_RELAYHOST=smtp.example.com
SMTP_RELAYHOST_USERNAME=user|name
SMTP_RELAYHOST_PASSWORD=a/b&c d\e|f
SMTP_MAIL_TO=root&admin@example.com
DHCP_ENABLED=true
DHCP_POOL_START=10.1.1.10
DHCP_POOL_END=10.1.1.250
DHCP_DOMAIN=a/b&c.local
