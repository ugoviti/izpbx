# postfix relay with SASL auth, networks, allowed senders, size limit
# expect: /etc/postfix/main.cf /etc/postfix/master.cf /etc/postfix/sasl_passwd /etc/postfix/allowed_senders /etc/postfix/sender_canonical_maps /etc/postfix/header_checks /etc/aliases
POSTFIX_ENABLED=true
SMTP_RELAYHOST=smtp.example.com
SMTP_RELAYHOST_PORT=587
SMTP_RELAYHOST_USERNAME=relayuser
SMTP_RELAYHOST_PASSWORD=relay-pw
SMTP_MYNETWORKS=127.0.0.0/8 192.168.0.0/16
SMTP_ALLOWED_SENDER_DOMAINS=example.com example.org
SMTP_MESSAGE_SIZE_LIMIT=67108864
SMTP_MAIL_FROM=izpbx@example.com
SMTP_MAIL_TO=admin@example.com
