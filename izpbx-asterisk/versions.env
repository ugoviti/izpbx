## FreePBX (D19) - https://mirror.freepbx.org/modules/packages/freepbx/
# the mirror only publishes freepbx-17.0-latest.tgz: the sha256 pins its content
# (framework 17.0.33); izpbx-asterisk/tools/make-updates.sh reports when "latest" moves
FREEPBX_VER=17
FREEPBX_FRAMEWORK_VER=17.0.33
FREEPBX_SHA256=57bfe353de693cd9f0f03b4e6cda68da69fd39c4beb9506fc06c8814ec40e538

## PHP extensions - https://www.ioncube.com/loaders.php (versioned tarball per architecture)
IONCUBE_VER=15.5.1
IONCUBE_SHA256_X86_64=739962bd012e77ee82bf01f77a9641f050e4be057f0a5d1a95fe59ce11fd62ba
IONCUBE_SHA256_AARCH64=b091974aa80a76bd798d71fd5209797d93749b0be13eaff978a3dbe0106b9e1f

## FOP2 - https://download2.fop2.com/fop2-<ver>-debian-<arch>.tgz
FOP2_VER=2.31.53
FOP2_SHA256_X86_64=a23913a0377e53aaeb526d841c666e6fb4c74bcbe055ccceed0c5bd65d90ab2e
# the "Debian 12 ARM64" download of fop2.com is an older release built for armhf
# (32-bit ARM, fop2-<ver>-debian-armv7l.tgz): it needs the armhf multiarch libc on arm64
FOP2_VER_AARCH64=2.31.48
FOP2_SHA256_AARCH64=afac074743e08599db81fc76ca3346b56f14f3ae5cc753f8ff5c8d60d48508dd

## Zabbix agent 2 - https://repo.zabbix.com/zabbix/<ver>/debian (bookworm)
# signing key from https://repo.zabbix.com/zabbix-official-repo.key (a bundle of
# several keys): only the key with this fingerprint is trusted
ZABBIX_VER=7.0
ZABBIX_GPG_FPR=4C3D6F2CC75F5146754FC374D913219AB5333005

## npm - https://registry.npmjs.org/npm (Node.js itself is Debian 12's 18.x)
# installed from the registry tarball instead of the Debian package, which
# pulls node-gyp and with it libnode-dev/libssl-dev/libuv1-dev (P1-10);
# npm 10.x is the last major that supports Node 18 (dist-tag next-10)
NPM_VER=10.9.9
NPM_SHA256=c80bd097147cce32e31010b791bab8c71a26a5e10668210ec9d2e7f4c7cea2a1

