# izPBX 22.17 component versions and checksums (single source of truth, D17).
#
# Read by the build scripts in build/ (they source this file) and by
# izpbx-asterisk/tools/make-updates.sh. Plain KEY=value lines only: no spaces, no quotes,
# no commands. Every *_SHA256* is the sha256 of the exact file that is
# downloaded; per architecture values end in _X86_64 / _AARCH64.

## base image
DEBIAN_IMAGE=docker.io/library/debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

## process supervisor (D13) - https://github.com/just-containers/s6-overlay/releases
S6_OVERLAY_VER=3.2.3.2
S6_OVERLAY_SHA256_NOARCH=5379750ed30a84bbd2e2dd74847ba6b5bd29cd0b2e3ea2ec58049b57eb2eda12
S6_OVERLAY_SHA256_X86_64=e6befcc96a437a3831386ecfc51808c5d3e939dc5fe3c02ae9284599e8aa2408
S6_OVERLAY_SHA256_AARCH64=b17f17a82e7a515c682a91edaf2ffdabb73f891981b6c1fd712115693a2f8b4c

## Asterisk (D5) - https://downloads.asterisk.org/pub/telephony/asterisk/releases/
ASTERISK_VER=22.11.0
ASTERISK_SHA256=3bd5ee040509a3d3cd9b1ba9520c18e6ec0a7e7981ca68c457dcd36ba3c54d94
# bundled third-party libraries (third-party/versions.mak of the Asterisk tarball;
# the tarball also carries their md5): https://github.com/asterisk/third-party
PJPROJECT_VER=2.17
PJPROJECT_SHA256=04b2eb1f0f01aa0ad1945b167171843448a51aa6b7c3e806496d434f13a112b7
JANSSON_VER=2.15.1
JANSSON_SHA256=f9aa4b3ec8496fee69db94f06f3d76fd4a26b012ee9bf1e917078c2cd2841881
# format_mp3 sources: svn export of https://svn.digium.com/svn/thirdparty/mp3/trunk at this
# revision; the sha256 is of "tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -cf - mp3"
ASTERISK_MP3_SVN_REV=204
ASTERISK_MP3_TREE_SHA256=8a1010f1b514e33f89c67e4981da098e168f0fbac03b560f5f985adf26ce6aff

