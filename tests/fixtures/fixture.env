# Environment of the izPBX container used to build fixtures (make-fixture.sh).
# Passwords are passed on the command line by make-fixture.sh.
TZ=Europe/Rome
APP_DATA=/data
MYSQL_SERVER=db
MYSQL_DATABASE=asterisk
MYSQL_DATABASE_CDR=asteriskcdrdb
MYSQL_USER=asterisk
# reproducible fixture: no module upgrades from the internet
FREEPBX_AUTOUPGRADE_CORE=false
FREEPBX_AUTOUPGRADE_MODULES=false
FREEPBX_AUTOUPDATE_MODULES_FIRSTDEPLOY=false
FREEPBX_FREEPBX_SYSTEM_IDENT=izPBX-fixture
FREEPBX_TONEZONE=it
FREEPBX_PHPTIMEZONE=Europe/Rome
# fail2ban needs NET_ADMIN, not part of the fixture content
FAIL2BAN_ENABLED=false
# fop2.cfg is part of the fixture (T5)
FOP2_ENABLED=true
