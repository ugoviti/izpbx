# every documented fail2ban key, including a sender and banaction
# expect: /etc/fail2ban/jail.d/99-local.conf /etc/fail2ban/fail2ban.conf
FAIL2BAN_ENABLED=true
FAIL2BAN_ASTERISK_ENABLED=true
FAIL2BAN_ASTERISK_LOGPATH=/var/log/asterisk/security
FAIL2BAN_DEFAULT_SENDER=fail2ban@example.com
FAIL2BAN_DEFAULT_DESTEMAIL=security@example.com
FAIL2BAN_DEFAULT_BANACTION=iptables-allports[blocktype=DROP]
FAIL2BAN_DEFAULT_IGNOREIP=127.0.0.0/8 10.0.0.0/8
FAIL2BAN_DEFAULT_BANTIME=600
FAIL2BAN_DEFAULT_FINDTIME=1200
FAIL2BAN_DEFAULT_MAXRETRY=5
FAIL2BAN_RECIDIVE_ENABLED=false
FAIL2BAN_RECIDIVE_BANTIME=86400
FAIL2BAN_RECIDIVE_FINDTIME=604800
FAIL2BAN_RECIDIVE_MAXRETRY=3
