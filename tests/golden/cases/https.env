# HTTPS with redirect, FQDN vhost and access list
# expect: /etc/httpd/conf.d/virtual.conf /etc/httpd/conf.d/phonebook.conf /etc/izpbx/cron.env
APP_FQDN=pbx.example.com
HTTPD_HTTPS_ENABLED=true
HTTPD_REDIRECT_HTTP_TO_HTTPS=true
HTTPD_ALLOW_FROM=10.0.0.0/8 192.168.0.0/16
APP_PORT_HTTP=8080
APP_PORT_HTTPS=8443
